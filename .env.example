# ==============================================================================
# VoiceRag - Enterprise Multilingual AI Voice & Knowledge Assistant
# Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
PORT=8000
FRONTEND_PORT=3000

# SQLite Database (WAL mode enabled by default)
DATABASE_URL=sqlite:///./data/voicerag.db

# Qdrant Vector Storage
QDRANT_STORAGE_PATH=./data/qdrant
QDRANT_COLLECTION_NAME=voicerag_knowledge

# AI Provider Credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com/v1

# Real-time WebRTC / Voice (LiveKit)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Default AI Settings
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=anthropic/claude-3.5-sonnet
DEFAULT_STT_PROVIDER=openai
DEFAULT_STT_MODEL=whisper-1
DEFAULT_TTS_PROVIDER=openai
DEFAULT_TTS_MODEL=tts-1
DEFAULT_VOICE=alloy
DEFAULT_LANGUAGE=auto

# RAG Configuration
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
RERANKING_ENABLED=true
